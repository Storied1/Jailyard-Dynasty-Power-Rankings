{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Writer input registry",
  "type": "object",
  "required": ["kind", "rule", "source_classes"],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "writer-input-registry/1"
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "rule_boundary": {
      "type": "string",
      "minLength": 1
    },
    "source_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "what", "paths"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "read_as": {
            "description": "How the writer consumes this class. Default 'facts': the registry rule binds it, and anything drawn from it must trace and date. 'form' means the class is read for register, structure and rhythm rather than for assertions; quoting its text still goes through the ordinary verbatim path.",
            "enum": ["facts", "form"]
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
