{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team registry",
  "type": "object",
  "required": ["season", "teams"],
  "properties": {
    "season": {
      "type": "integer"
    },
    "generated_from": {
      "type": "string"
    },
    "teams": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["roster_id", "name", "owner", "owner_id"],
        "additionalProperties": false,
        "properties": {
          "roster_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "owner_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
