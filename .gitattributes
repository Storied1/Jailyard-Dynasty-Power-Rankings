# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF on known text types
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf

# Windows-specific files keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files — never diff, never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.sqlite binary

# Lock files — generated, treat as binary for merge
package-lock.json binary
yarn.lock         binary
pnpm-lock.yaml    binary
uv.lock           binary
