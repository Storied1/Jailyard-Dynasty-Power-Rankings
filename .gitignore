# Large temporary files (players.json is ~5MB, only needed during fetch)
data/players.json

# Projection files are huge (~100MB each) and can be re-fetched
data/*/projections.json

# NFL stats cache (~2MB per week × 18 weeks/season). Fetched from Sleeper
# on demand; fetch_sleeper.py [8/8] re-populates. Not source of truth.
# Kept locally but never committed, same pattern as projections.
data/*/nfl_stats_week*.json

# Python bytecode cache
__pycache__/

# Duplicate zip extraction artifacts
Jailyard-Dynasty-Power-Rankings-main/

# API keys — never commit
.env

# Generated media pipeline artifacts
**/media_cache.json
**/media_picks.json
**/preview.html
**/.resolve_state.json

# Git worktrees
.worktrees/

# OS system files
.DS_Store
Thumbs.db

# Security — never commit
*.key
*.pem
*.ppk
*.env.local
.claude/settings.local.json

# Raw WhatsApp export and parsed data (privacy — top-level only)
/chat/

# WhatsApp raw export folder
WhatsApp Chat*/

# MAP phase intermediate cache (regenerable from chat/parsed_messages.json)
content/chat/.map_cache/

# Playwright MCP artifacts
.playwright-mcp/
.superpowers/
